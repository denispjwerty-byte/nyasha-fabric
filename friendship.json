   "character": "sly",
   "track": "friendship",
   "category": "greeting",
   "tags": [
    "friendship"
   ],
   "priority": 20,
   "conditions": {
    "event": "ambient"
   },
   "source_note": "",
   "text": "Хм-м... Скучно! Давай придумаем какую-нибудь шалость!",
