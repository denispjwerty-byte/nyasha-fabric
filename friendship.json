     "id": "r1",
     "text": "Я тоже рад тебя видеть.",
     "effects": {
      "affection": 3,
      "trust": 1,
      "irritation": -1
     }
    },
    {
     "id": "r2",
     "text": "Иди сюда, обниму.",
     "effects": {
      "affection": 2,
      "romance": 1,
      "trust": 1
     }
    },
    {
     "id": "r3",
     "text": "Не сейчас.",
     "effects": {
      "affection": -1,
      "irritation": 3
     }
    }
