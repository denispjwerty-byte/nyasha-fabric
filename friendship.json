   "tags": [
    "friendship"
   ],
   "priority": 20,
   "conditions": {
    "event": "ambient"
   },
   "source_note": "",
   "text": "Эй, человечек! Не видел мои конфеты? Просто так спрашиваю...",
   "responses": [],
   "cooldown": 900,
   "repeatable": true
  },
