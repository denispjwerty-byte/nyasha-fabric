      "trust": 2
     }
    },
    {
     "id": "r3",
     "text": "Не выдумывай.",
     "effects": {
      "affection": -2,
      "trust": -2,
      "irritation": 3
     }
    }
   ],
   "cooldown": 3000,
   "repeatable": true
  },
